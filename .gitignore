# ---------- Node / Expo / React Native ----------
node_modules/
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# Native projects are generated by `npx expo prebuild` — never committed.
# Change app.json / config plugins instead, then rebuild.
# NOTE: anchored to the app subfolder, which lives one level below the repo
# root. A bare "/android/" would NOT match interntrack/android/.
/interntrack/android/
/interntrack/ios/

# Metro / bundler
.metro-health-check*
*.jsbundle

# Test output
coverage/

# ---------- Secrets & signing (NEVER commit) ----------
.env
.env.*
!.env.example
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.cer
*.certSigningRequest
credentials.json
google-services.json
GoogleService-Info.plist

# EAS
eas-build-*.log
*.orig.*

# ---------- Obsidian: per-machine state ----------
# Shared config (app.json, appearance, plugins) IS tracked; workspace layout is not.
# NOTE: leading ** is required — these paths are nested under obsidian/,
# and a ".obsidian/..." pattern would be anchored to the repo root.
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json
**/.obsidian/cache
**/.trash/
**/.obsidian/plugins/*/data.json

# ---------- OS / editor / logs ----------
.DS_Store
Thumbs.db
desktop.ini
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
