# Normalize line endings in the repository; check out per platform.
* text=auto

# Notes: keep LF in the repo, allow CRLF in a Windows working copy.
*.md   text eol=lf
*.json text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf

# Never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.keystore binary
*.jks binary
*.p12 binary
*.mobileprovision binary
